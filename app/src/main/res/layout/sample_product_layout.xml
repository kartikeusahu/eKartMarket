<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <androidx.cardview.widget.CardView
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/pinklight"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="10sp"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"

            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:id="@+id/sample_product_img"
                android:src="@drawable/product">

            </ImageView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lay's Onion Chips"
                android:gravity="center"
                android:id="@+id/sample_product_name"
                android:layout_marginTop="10sp"
                android:textColor="@color/black">

            </TextView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="0dp"
                android:gravity="center_vertical"
                android:padding="8dp">

                <!-- Selling Price -->
                <TextView
                    android:id="@+id/sample_product_salerate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹120/-"
                    android:textStyle="bold"

                    android:textColor="@color/black"
                android:layout_marginEnd="12dp"/>

                <!-- MRP Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MRP:"
                    android:textSize="16sp"
                    android:layout_marginEnd="4dp"/>

                <!-- Original MRP with strike-through -->
                <TextView
                    android:id="@+id/sample_product_mrp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹150"
                    android:textSize="16sp"
                    android:textColor="#9E9E9E" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500g"
                android:paddingHorizontal="10sp"
                android:layout_gravity="right"
                android:id="@+id/sample_productsize"
                >

            </TextView>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="15sp"
                    android:paddingRight="15sp"
                    android:paddingLeft="15sp"
                    android:paddingTop="5sp"
                    android:id="@+id/sample_productminus"
                    android:paddingBottom="5sp"
                    android:background="@color/gray">

                </TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:paddingRight="15sp"
                    android:paddingLeft="15sp"
                    android:id="@+id/sample_productquantity"
                    android:paddingTop="5sp"
                    android:paddingBottom="5sp"
                    android:background="@color/white">

                </TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="15sp"
                    android:id="@+id/sample_productplus"
                    android:paddingRight="15sp"
                    android:paddingLeft="15sp"
                    android:paddingTop="5sp"
                    android:paddingBottom="5sp"
                    android:background="@color/gray">

                </TextView>
            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>